# Copie para .env e preencha. O arquivo .env nunca deve ser compartilhado.

# Modo: "nao" só gera a planilha a partir das janelas (você lança no Tempo à mão).
# "sim" usa a API do Jira e do Tempo (hoje bloqueada pelo Cloudflare da TOTVS).
USAR_JIRA=nao

# Projetos aceitos como chave de ticket nos títulos das janelas (ex. DMANESTOQ), separados por vírgula.
# Vazio aceita qualquer chave, inclusive falsos positivos como UTF-8.
PROJETOS=

# Observador de janelas
INTERVALO_SEGUNDOS=5
OCIOSO_MINUTOS=5

# Jira Data Center da TOTVS (só com USAR_JIRA=sim)
JIRA_URL=https://jiraproducao.totvs.com.br
# Token pessoal: Perfil > Personal access tokens > Create token
JIRA_TOKEN=

# Jornada e arredondamento
JORNADA_MINUTOS=450
BLOCO_MINUTOS=15
INICIO_DIA=09:00
FUSO=America/Sao_Paulo

# Ticket que recebe reuniões sem chave no título (deixe vazio para preencher na revisão)
TICKET_REUNIOES=

# Eventos da agenda a ignorar (parte do título, separados por vírgula)
IGNORAR_EVENTOS=Almoço,Almoco,Bloqueio,Foco

# Google Agenda (opcional). Sem este arquivo, a agenda é ignorada.
GOOGLE_CREDENTIALS=credentials.json
GOOGLE_TOKEN=token.json

# Banco local
BANCO=trampotime.db
